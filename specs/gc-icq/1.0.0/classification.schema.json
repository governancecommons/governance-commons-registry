{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/specs/gc-icq/1.0.0/classification.schema.json",
  "title": "GC–ICQ.01 Classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "assetId",
    "impact",
    "access",
    "quadrant",
    "dataLabels",
    "publication"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0.0"
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "enum": [
        "low",
        "high"
      ]
    },
    "access": {
      "enum": [
        "restricted",
        "open"
      ]
    },
    "quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    "dataLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PERSONAL_DATA",
          "CREDENTIAL",
          "EMBARGOED",
          "PROPRIETARY",
          "SECURITY_FINDING",
          "OTHER_SENSITIVE"
        ]
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvalRecordId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "rationale",
        "expiresAt",
        "mitigations"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "mitigations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "impact": {
            "const": "high"
          },
          "access": {
            "const": "restricted"
          }
        }
      },
      "then": {
        "properties": {
          "quadrant": {
            "const": "Q1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "impact": {
            "const": "low"
          },
          "access": {
            "const": "restricted"
          }
        }
      },
      "then": {
        "properties": {
          "quadrant": {
            "const": "Q2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "impact": {
            "const": "low"
          },
          "access": {
            "const": "open"
          }
        }
      },
      "then": {
        "properties": {
          "quadrant": {
            "const": "Q3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "impact": {
            "const": "high"
          },
          "access": {
            "const": "open"
          }
        }
      },
      "then": {
        "properties": {
          "quadrant": {
            "const": "Q4"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "status",
              "approvedBy",
              "approvalRecordId"
            ]
          }
        }
      }
    }
  ]
}
