{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/schemas/governance-record.schema.json",
  "title": "Governance Record",
  "description": "Machine-readable record of a governed observation, intent, decision, authorization, action, transition, or related governance event.",
  "type": "object",
  "additionalProperties": true,
  "required": ["record_id", "record_type", "schema_version", "actor", "timestamps"],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "record_type": {"type":"string","enum":["observation","intent","decision","approval","action","dispatch","handoff","escalation","validation","conformance","certification","registration","revocation","provenance"]},
    "schema_version": {"const":"1.0.0"},
    "subject": {"$ref":"#/$defs/ref"},
    "actor": {"$ref":"#/$defs/ref"},
    "authority": {"$ref":"#/$defs/authority"},
    "intent": {"type":"object","required":["statement"],"properties":{"statement":{"type":"string","minLength":1},"objective":{"type":"string"}},"additionalProperties":true},
    "decision": {"type":"object","required":["statement"],"properties":{"statement":{"type":"string","minLength":1},"outcome":{"type":"string"}},"additionalProperties":true},
    "approval": {"$ref":"#/$defs/approval"},
    "action": {"$ref":"#/$defs/action"},
    "dispatch": {"type":"object","required":["target"],"properties":{"target":{"$ref":"#/$defs/ref"},"scope":{"type":"string"}},"additionalProperties":true},
    "handoff": {"$ref":"#/$defs/handoff"},
    "escalation": {"type":"object","required":["reason","target"],"properties":{"reason":{"type":"string","minLength":1},"target":{"$ref":"#/$defs/ref"}},"additionalProperties":true},
    "validation": {"type":"object","required":["result"],"properties":{"result":{"enum":["valid","invalid","conformant","non-conformant"]},"specification":{"type":"string"}},"additionalProperties":true},
    "conformance": {"type":"object","required":["report","result","specification","specification_version"],"properties":{"report":{"$ref":"#/$defs/ref"},"result":{"enum":["conformant","non-conformant"]},"specification":{"$ref":"#/$defs/ref"},"specification_version":{"type":"string"},"profile":{"type":"string"}},"additionalProperties":true},
    "certification": {"type":"object","required":["result"],"properties":{"result":{"type":"string"},"certificate":{"type":"string"}},"additionalProperties":true},
    "registration": {"type":"object","required":["subject"],"properties":{"subject":{"$ref":"#/$defs/ref"},"registry":{"type":"string"}},"additionalProperties":true},
    "relations": {"type":"array","items":{"type":"object","required":["type","target"],"properties":{"type":{"type":"string"},"target":{"$ref":"#/$defs/ref"}},"additionalProperties":true}},
    "lifecycle": {"type":"object","properties":{"status":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":true},
    "framework_context": {"type":"object","additionalProperties":true},
    "governance_context": {"type":"object","additionalProperties":true},
    "provenance": {"type":"object","properties":{"source":{"$ref":"#/$defs/ref"},"method":{"type":"string"}},"additionalProperties":true},
    "timestamps": {"$ref":"#/$defs/timestamps"},
    "extensions": {"type":"object","additionalProperties":true}
  },
  "allOf": [
    {"if":{"properties":{"record_type":{"const":"approval"}}},"then":{"required":["subject","approval"]}},
    {"if":{"properties":{"record_type":{"const":"action"}}},"then":{"required":["subject","action","authority"]}},
    {"if":{"properties":{"record_type":{"const":"handoff"}}},"then":{"required":["subject","authority","handoff"]}},
    {"if":{"properties":{"record_type":{"const":"conformance"}}},"then":{"required":["subject","conformance"]}},
    {"if":{"properties":{"record_type":{"const":"revocation"}}},"then":{"required":["subject","relations"]}},
    {"if":{"properties":{"record_type":{"const":"intent"}}},"then":{"required":["intent"]}},
    {"if":{"properties":{"record_type":{"const":"decision"}}},"then":{"required":["decision"]}},
    {"if":{"properties":{"record_type":{"const":"dispatch"}}},"then":{"required":["dispatch"]}},
    {"if":{"properties":{"record_type":{"const":"escalation"}}},"then":{"required":["escalation"]}},
    {"if":{"properties":{"record_type":{"const":"validation"}}},"then":{"required":["validation"]}},
    {"if":{"properties":{"record_type":{"const":"certification"}}},"then":{"required":["certification"]}},
    {"if":{"properties":{"record_type":{"const":"registration"}}},"then":{"required":["registration"]}},
    {"if":{"properties":{"record_type":{"const":"provenance"}}},"then":{"required":["provenance"]}}
  ],
  "$defs": {
    "ref":{"type":"object","required":["type","id"],"properties":{"type":{"type":"string","minLength":1},"id":{"type":"string","minLength":1}},"additionalProperties":true},
    "authority":{"type":"object","required":["basis","authority_id","status"],"properties":{"basis":{"type":"string"},"authority_id":{"type":"string","minLength":1},"status":{"enum":["pending","active","revoked","expired"]},"granted_at":{"type":"string"},"revoked_at":{"type":"string"}},"additionalProperties":true},
    "approval":{"type":"object","required":["required","status","approver","scope","timestamp"],"properties":{"required":{"type":"boolean"},"status":{"enum":["pending","approved","rejected","revoked"]},"approver":{"$ref":"#/$defs/ref"},"scope":{"type":"string"},"timestamp":{"type":"string"}},"additionalProperties":true},
    "action":{"type":"object","required":["type","status"],"properties":{"type":{"type":"string"},"description":{"type":"string"},"status":{"enum":["proposed","authorized","started","completed","failed","cancelled"]},"target":{"$ref":"#/$defs/ref"}},"additionalProperties":true},
    "handoff":{"type":"object","required":["from","to","status","scope","authority_transfer","trust_boundary","acceptance"],"properties":{"from":{"$ref":"#/$defs/ref"},"to":{"$ref":"#/$defs/ref"},"status":{"enum":["proposed","accepted","rejected","completed"]},"scope":{"type":"object","required":["description"],"properties":{"task":{"$ref":"#/$defs/ref"},"description":{"type":"string"},"completed":{"type":"array","items":{"type":"string"}},"remaining":{"type":"array","items":{"type":"string"}},"blocked":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},"authority_transfer":{"type":"object","required":["transferred","authority_ref","scope","delegated_by"],"properties":{"transferred":{"type":"boolean"},"authority_ref":{"$ref":"#/$defs/ref"},"scope":{"type":"array","items":{"type":"string"}},"delegated_by":{"$ref":"#/$defs/ref"}},"additionalProperties":true},"trust_boundary":{"type":"object","required":["crossed","boundary_type","boundary_ref"],"properties":{"crossed":{"type":"boolean"},"boundary_type":{"type":"string"},"boundary_ref":{"$ref":"#/$defs/ref"},"additional_controls_required":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},"acceptance":{"type":"object","required":["accepted_by","accepted_at"],"properties":{"accepted_by":{"$ref":"#/$defs/ref"},"accepted_at":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},
    "timestamps":{"type":"object","required":["created_at","occurred_at"],"properties":{"created_at":{"type":"string"},"occurred_at":{"type":"string"},"authorized_at":{"type":"string"},"completed_at":{"type":"string"}},"additionalProperties":true}
  }
}