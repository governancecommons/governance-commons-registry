{
  "name": "governance-commons",
  "version": "0.1.1",
  "description": "Governance Commons reference implementation — ONS name validation, schema utilities, and shared types for TypeScript/JavaScript adopters.",
  "keywords": [
    "governance",
    "naming",
    "ons",
    "ontic-namespace-structure",
    "schema",
    "validation",
    "agent"
  ],
  "license": "MIT",
  "author": "jj-ervin",
  "homepage": "https://github.com/governancecommons/governance-commons-registry",
  "repository": {
    "type": "git",
    "url": "https://github.com/governancecommons/governance-commons-registry"
  },
  "type": "module",
  "bin": {
    "gc-validate": "./dist/esm/gc-validate.js",
    "gc-report": "./dist/esm/gc-report.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./ons": {
      "import": "./dist/esm/ons.js",
      "require": "./dist/cjs/ons.js",
      "types": "./dist/types/ons.d.ts"
    },
    "./report": {
      "import": "./dist/esm/report.js",
      "require": "./dist/cjs/report.js",
      "types": "./dist/types/report.d.ts"
    }
  },
  "files": [
    "dist/cjs/",
    "dist/esm/",
    "dist/types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
